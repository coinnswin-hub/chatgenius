# WhatsApp API Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Alternative: Meta WhatsApp Business Cloud API
# META_WHATSAPP_TOKEN=your_meta_whatsapp_token
# META_WHATSAPP_PHONE_ID=your_phone_number_id
# META_VERIFY_TOKEN=your_webhook_verify_token

# Cafe Website Configuration
CAFE_WEBSITE_URL=https://www.iamcafe.com/
SCRAPE_INTERVAL_MINUTES=60

# Application Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Data Storage
DATA_DIR=./data
CACHE_DIR=./data/cache
